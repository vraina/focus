# Copy to server/.env and fill in. server/.env is ignored by git.

# Claude API key, from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Any long random string for local use.
SECRET_KEY=local-dev-secret-change-me

# Your Atlas connection string (a user with readWrite on the database), or a local mongod.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=focussprint_dev

# Leave RESEND_API_KEY empty to have emails written to the log instead of sent.
RESEND_API_KEY=
MAIL_FROM=YoungWonks Focus <onboarding@resend.dev>
# The owner's account, created on first start. Only this account can issue invitations to other families.
PARENT_EMAIL=
PARENT_PASSWORD=
# Where parents download the Mac installer (shown on the Computers page), and each family's daily Claude allowance.
DOWNLOAD_URL=
FAMILY_DAILY_AI_CALLS=600

PUBLIC_URL=http://127.0.0.1:5077
TIMEZONE=America/Los_Angeles
DIGEST_HOUR=21
# Pictures and clips older than this many days are deleted from the database. The switch records are kept.
MEDIA_KEEP_DAYS=14
